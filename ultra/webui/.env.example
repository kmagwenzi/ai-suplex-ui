# AI-Suplex Ultra — local thin host. No secrets here; these are local paths only.

# Absolute path to the AI-Suplex-777 vault (read-only to this app).
# Defaults to ~/Projects/AI-Suplex-OS/Deep-Ultra-OS/AI-Suplex-777 when unset.
AISUPLEX_VAULT="/home/kmagwenzi/Projects/AI-Suplex-OS/Deep-Ultra-OS/AI-Suplex-777"

# Capability tier: "ultra" (default) | "free". A capability flag, never a license.
# Under "free" the six Ultra surfaces render a named gate, not a preview.
AISUPLEX_TIER="ultra"

# Optional enrichment for the ⌘K command bar (Spec — Ultra UI Integration §12).
# All three are required; a stray provider key alone does NOT enable it.
# Without them the bar still works — a deterministic matcher picks the command.
# AISUPLEX_MODEL_PROVIDER="openai"          # openai | anthropic | deepseek | google | openrouter | custom
# AISUPLEX_MODEL_ID="gpt-4o-mini"
# AISUPLEX_MODEL_API_KEY=""                 # or the provider's own key var (OPENAI_API_KEY, …)
# AISUPLEX_MODEL_BASE_URL=""                # custom / self-hosted endpoints only
